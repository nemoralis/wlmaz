{
  "name": "wlmaz",
  "version": "1.0.0",
  "description": "Wiki Loves Monuments Azerbaijan Map",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host",
    "dev:backend": "NODE_ENV=development tsx watch --env-file=.env src/index.ts",
    "update-data": "tsx scripts/update-monuments.ts && npm run convert-data",
    "convert-data": "json2geobuf < public/monuments.geojson > public/monuments.pbf",
    "build": "npm run convert-data && vue-tsc -b && vite build && tsx scripts/prerender.ts && npm run verify",
    "prerender": "tsx scripts/prerender.ts",
    "verify": "tsx scripts/verify-prerender.ts && html-validate \"dist/**/*.html\"",
    "preview": "vite preview --host",
    "format": "prettier --write --list-different src/",
    "lint": "eslint src/ --ext .ts,.vue --fix",
    "test": "vitest run",
    "analyze": "vite-bundle-visualizer",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,js}": "eslint --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@unhead/vue": "3.3.2",
    "@wikimedia/codex": "2.6.2",
    "@wikimedia/codex-icons": "2.6.2",
    "chart.js": "4.5.1",
    "connect-redis": "10.0.0",
    "exifr": "7.1.3",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-session": "1.19.0",
    "fuse.js": "7.5.0",
    "geobuf": "4.0.0",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "leaflet": "1.9.4",
    "leaflet-minimap": "3.6.1",
    "leaflet-sidebar-v2": "3.2.3",
    "leaflet.locatecontrol": "0.90.1",
    "morgan": "1.11.0",
    "multer": "2.2.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.0.1",
    "oauth-1.0a": "2.2.6",
    "passport": "0.7.0",
    "passport-mediawiki-oauth": "0.1.0",
    "pbf": "5.1.2",
    "pinia": "4.0.3",
    "rate-limit-redis": "6.0.1",
    "redis": "6.2.1",
    "sharp": "0.35.3",
    "vue": "3.5.41",
    "vue-chartjs": "5.3.4",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@rushstack/eslint-patch": "1.16.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/connect-redis": "0.0.23",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/geobuf": "3.0.4",
    "@types/geojson": "7946.0.16",
    "@types/hpp": "0.2.7",
    "@types/leaflet": "1.9.22",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/passport": "1.0.17",
    "@types/pbf": "3.0.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "geojson": "0.5.0",
    "html-validate": "11.6.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svgo": "4.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-bundle-visualizer": "1.2.1",
    "vite-plugin-image-optimizer": "2.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "passport": "0.7.0",
    "rollup-plugin-visualizer": {
      "rolldown": "npm:rolldown@latest"
    }
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.0": true
  }
}
