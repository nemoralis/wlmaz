# ========================================================
# Wiki Loves Monuments Azerbaijan - Environment Variables
# Copy this file to `.env` and fill in your values.
# ========================================================

# --- MediaWiki OAuth (Production / Commons) ---
# Credentials from https://commons.wikimedia.org/wiki/Special:OAuthConsumerRegistration
WM_CONSUMER_KEY=
WM_CONSUMER_SECRET=

# --- App ---
PORT=3000
CLIENT_URL=http://localhost:5173

# Session signing secret. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=ChangeMeToARandomStringAtLeast32CharsLong

# Redis connection string (sessions, rate limiting, leaderboard cache)
REDIS_URL=redis://:redispassword@localhost:6379

# Enable photo uploads to Wikimedia Commons ("true" to enable)
ENABLE_UPLOADS=false

# --- Local MediaWiki upload testing (DEVELOPMENT ONLY) ---
# Lets the dev build upload to a local MediaWiki instance using a Bot Password,
# without requiring the Commons OAuth login. IGNORED when NODE_ENV=production.
# NEVER commit real bot credentials. See README "Local MediaWiki upload testing".
#
# Enable local dev upload mode ("true" to enable):
# MEDIAWIKI_DEV_MODE=true
# API URL of the local MediaWiki (must include /w/api.php):
# MEDIAWIKI_API_URL=http://localhost:8080/w/api.php
# Bot username in "User@BotName" format (from Special:BotPasswords):
# MEDIAWIKI_DEV_USERNAME=BotName@BotPasswordName
# The generated bot password (NOT your normal password):
# MEDIAWIKI_DEV_BOT_PASSWORD=

# IndexNow key for notifying search engines of monument changes
# (used by scripts/update-monuments.ts, often set as a CI secret)
INDEXNOW_KEY=
